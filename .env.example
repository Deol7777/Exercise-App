# Copy to .env.local and fill in. .env.local is gitignored; this file is not —
# never put a real secret, key or connection string here.

# --- Neon PostgreSQL (ADR 0006) ------------------------------------------
# Two connection strings, both taken from the Neon console for the same
# database. They are NOT interchangeable: swapping them produces failures
# that only show up under load.
#
# DATABASE_URL is the POOLED string — note the "-pooler" in the host. The
# running app uses this one, because every serverless invocation may open
# its own connection.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full&channel_binding=require"

# DATABASE_URL_UNPOOLED is the DIRECT string — same host without "-pooler".
# drizzle-kit uses this one; migrations need a real session, not a pooled
# connection.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=verify-full&channel_binding=require"

# --- Auth.js v5 (ADR 0005) -----------------------------------------------
# Signs and encrypts the session token. Generate your own:
#   npx auth secret
# or: openssl rand -base64 32
AUTH_SECRET=""

# Only needed if the app is not served from the URL Auth.js infers. Vercel
# sets this automatically; localhost does not need it. Uncomment if a
# callback ever lands on the wrong origin.
# AUTH_URL="http://localhost:3000"
